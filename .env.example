TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_PHONE=
TELEGRAM_CHANNELS=all
# Archived channels are skipped. Set to 1 to include them.
TELEGRAM_INCLUDE_ARCHIVED=0

# Optional: send the PDF to a chat through a bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

DIGEST_DEFAULT_HOURS=6
DIGEST_MAX_HOURS=168
DIGEST_OUTPUT_DIR=out
LOG_LEVEL=INFO

# LLM digest (OpenAI-compatible gateway)
LLM_BASE_URL=https://api.a6api.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_INPUT_CHARS=50000
LLM_PER_MESSAGE_CHARS=700
LLM_MAX_OUTPUT_TOKENS=4000
